{
    "name": "frontend-angular",
    "version": "0.0.0",
    "scripts": {
        "ng": "node ./node_modules/@angular/cli/bin/ng.js",
        "start": "node ./node_modules/@angular/cli/bin/ng.js serve --proxy-config proxy.conf.json",
        "build": "node ./node_modules/@angular/cli/bin/ng.js build",
        "watch": "node ./node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
        "test": "node ./node_modules/@angular/cli/bin/ng.js test"
    },
    "private": true,
    "packageManager": "npm@11.9.0",
    "overrides": {
        "picomatch": "4.0.4",
        "undici": "7.24.4",
        "vite": "7.3.2"
    },
    "dependencies": {
        "@angular/common": "^21.2.0",
        "@angular/compiler": "^21.2.0",
        "@angular/core": "^21.2.0",
        "@angular/forms": "^21.2.0",
        "@angular/platform-browser": "^21.2.0",
        "@angular/router": "^21.2.0",
        "@angular/service-worker": "21.2.5",
        "@dataconnect/generated": "file:src/dataconnect-generated",
        "firebase": "12.12.0",
        "ngx-image-cropper": "^9.1.6",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^21.2.3",
        "@angular/cli": "^21.2.3",
        "@angular/compiler-cli": "^21.2.0",
        "@tailwindcss/postcss": "^4.2.2",
        "jsdom": "^28.0.0",
        "postcss": "^8.5.8",
        "prettier": "^3.8.1",
        "tailwindcss": "^4.2.2",
        "typescript": "~5.9.2",
        "vitest": "^4.0.8"
    }
}
