# ====================================
# UCACUE Bar - Backend Environment
# ====================================
# Copiar este archivo como .env y configurar los valores

# --- Base de Datos Supabase PostgreSQL ---
DB_HOST=aws-0-us-west-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASS=your_database_password_here
DB_SSL_MODE=require
DB_SCHEMA=bar_app
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSL_MODE}&currentSchema=${DB_SCHEMA},public
DB_DRIVER_CLASS_NAME=org.postgresql.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
FLYWAY_LOCATIONS=classpath:db/migration/postgresql

# --- JWT Authentication ---
# Generar un secreto seguro: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# --- Servidor ---
SERVER_PORT=8081
CONTEXT_PATH=/api
LOG_LEVEL=info
SHOW_SQL=false

# --- Firebase (Opcional) ---
FIREBASE_ENABLED=false
FIREBASE_AUTH_ENABLED=false
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Origenes Permitidos (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:4200,http://127.0.0.1:4200,http://localhost:5173,http://127.0.0.1:5173

# --- Acceso privado y leads publicos ---
PUBLIC_TENANT_REGISTRATION_ENABLED=false
PUBLIC_LEADS_NOTIFY_TO=soporte@insightvisionia.cloud
VISION_RATE_LIMIT_PER_MINUTE=1800

# --- WebRTC MediaMTX (Opcional) ---
WEBRTC_GATEWAY_BASE=http://localhost:8889

# --- Usuario Administrador Inicial ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_before_running
BUYER_EMAIL=
BUYER_PASSWORD=

# --- Perfil recomendado para desarrollo local ---
SPRING_PROFILES_ACTIVE=local

# --- SRI Ecuador: Ambiente 2 / Produccion Controlada ---
SRI_CONNECT_TIMEOUT_MS=5000
SRI_READ_TIMEOUT_MS=15000
SRI_AUTHORIZATION_POLL_DELAY_MS=1500
SRI_AUTO_QUERY_AFTER_RECEPTION=true

# Llave maestra para cifrar las claves .p12 guardadas por tenant.
# Genera una llave segura con: openssl rand -base64 32
SRI_SIGNATURE_PASSWORD_MASTER_KEY=change_this_with_32_random_bytes_base64

# Fallback local/legacy solamente. En multi-tenant real, la firma se carga en tax_sri_settings.
SRI_SIGNATURE_MODE=NONE
SRI_PKCS12_PATH=
SRI_PKCS12_PASSWORD=
SRI_KEY_ALIAS=

# Ambiente 1 / pruebas
SRI_TEST_RECEPTION_URL=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline
SRI_TEST_AUTHORIZATION_URL=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline

# Ambiente 2 / oficial
SRI_PRODUCTION_RECEPTION_URL=https://cel.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline
SRI_PRODUCTION_AUTHORIZATION_URL=https://cel.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline

# --- Almacenamiento RIDE (PDF/XML) en Supabase Storage ---
# Si SRI_RIDE_STORAGE_PROVIDER=SUPABASE el sistema sube los PDF/XML al bucket.
# El proyecto ya tiene un bucket llamado "facturas-sri".
SRI_RIDE_STORAGE_PROVIDER=LOCAL
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SRI_RIDE_SUPABASE_BUCKET=facturas-sri
# URL publica para acceder a los archivos (si el bucket es publico)
SRI_RIDE_PUBLIC_BASE_URL=

# --- Envio de comprobantes por Resend (HTTP) ---
# 1. Crea la API key en https://resend.com/api-keys
# 2. Verifica tu dominio en https://resend.com/domains (usa el dominio en el FROM)
# 3. Pega los dos valores aqui. Listo: el sistema enviara el XML+RIDE a todos los tenants
#    desde ese unico correo verificado.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=soporte@insightvisionia.cloud
RESEND_FROM_NAME=Insight Vision IA
RESEND_REPLY_TO=soporte@insightvisionia.cloud
RESEND_WEBHOOK_SECRET=
RESEND_BASE_URL=https://api.resend.com
RESEND_CONNECT_TIMEOUT_MS=5000
RESEND_READ_TIMEOUT_MS=15000
RESEND_MAX_ATTACHMENT_BYTES=10000000
RESEND_MAX_TOTAL_ATTACHMENT_BYTES=20000000

# Activa el envio del RIDE por correo despues de la autorizacion del SRI
SRI_RIDE_EMAIL_ENABLED=true
# true = Resend manda desde el FROM unico (recomendado multi-tenant)
SRI_RIDE_CENTRAL_RELAY_ENABLED=true

# --- Docker local ---
PORT=8080
SPRING_PROFILES_ACTIVE=docker
DATABASE_URL=jdbc:postgresql://postgres:5432/sistema_integrado
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:4200,http://localhost:3000
FIREBASE_CREDENTIALS_PATH=
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/storage
