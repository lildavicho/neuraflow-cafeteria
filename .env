# ========================
# 🔐 UCACUE BAR CONFIG
# ========================

# --- Base de Datos ---
# IMPORTANTE: cuando se ejecuta con Docker Compose, el backend se conecta al servicio 'mysql'
# por lo que el host debe ser 'mysql'. Para clientes externos (Workbench) use 127.0.0.1:3306.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ucacue_erp
DB_URL=mysql:3306
DB_USER=ucacue_user
DB_PASS=ucacue_pass

# --- JWT y Seguridad ---
# 64 chars (>=256 bits)
JWT_SECRET=9a78f8e6d9b14d2ca1b0a7c4e6f3b2a19d8c7e6f5a4b3c2d1e0f9a8b7c6d5e4f
JWT_EXPIRATION=86400

# --- Correo (para 2FA) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Firebase (opcional) ---
FIREBASE_SERVICE_ACCOUNT_PATH=src/main/resources/firebase_credentials.json
FIREBASE_PROJECT_ID=ucacuebar

# --- Algolia (opcional o usar fallback) ---
ALGOLIA_APP_ID=your-app-id
ALGOLIA_API_KEY=your-api-key
ALGOLIA_INDEX_NAME=products

# --- WebRTC (MediaMTX) ---
WEBRTC_GATEWAY_BASE=http://localhost:8554

# --- Configuración App ---
SERVER_PORT=8080
CONTEXT_PATH=/api
DDL_AUTO=update
SHOW_SQL=true
LOG_LEVEL=DEBUG

# --- Frontend URL (para CORS) ---
FRONTEND_URL=http://localhost:3001

# --- Usuario inicial ADMIN ---
ADMIN_EMAIL=admin@ucacue.edu.ec
ADMIN_PASSWORD=Admin123!

