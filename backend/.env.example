# ====================================
# UCACUE Bar - Backend Environment
# ====================================
# Copiar este archivo como .env y configurar los valores

# --- Base de Datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ucacue_erp
DB_USER=ucacue_user
DB_PASS=your_database_password_here

# --- JWT Authentication ---
# Generar un secreto seguro: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# --- Redis Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Servidor ---
SERVER_PORT=8080
CONTEXT_PATH=/api
LOG_LEVEL=info
SHOW_SQL=false

# --- Firebase (Opcional) ---
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccount.json

# --- Origenes Permitidos (CORS) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# --- Pagos (Opcional) ---
PAYPHONE_KEY=your_payphone_key
PAYPHONE_ENDPOINT=https://pay.payphonetodoesposible.com/api
DATAFAST_KEY=your_datafast_key
DATAFAST_ENDPOINT=https://sandbox.datafast.com.ec/api

# --- WebRTC MediaMTX (Opcional) ---
WEBRTC_GATEWAY_BASE=http://localhost:8889

# --- Algolia Search (Opcional) ---
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_api_key
ALGOLIA_INDEX_NAME=productos_venta

# --- Usuario Administrador Inicial ---
ADMIN_EMAIL=admin@ucacue.edu.ec
ADMIN_PASSWORD=Admin123!
