# --- Base de Datos ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ucacue_erp
DB_USER=ucacue_user
DB_PASS=ucacue_pass

# --- JWT ---
JWT_SECRET=ucacue-bar-jwt
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# --- Firebase (Admin SDK) ---
FIREBASE_PROJECT_ID=baru-fe8a3
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_PATH=/app/serviceAccount.json

# --- CORS ---
# Permite conexión desde frontend (Docker, localhost y Nginx)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://frontend:5173,http://nginx,http://localhost

# --- Logs ---
SPRING_PROFILES_ACTIVE=docker
LOG_LEVEL=info

