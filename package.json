{
  "private": true,
  "type": "module",
  "scripts": {
    "frontend:start": "npm --prefix apps/web-angular run start",
    "frontend:build": "npm --prefix apps/web-angular run build",
    "backend:start:local": "node ./ops/scripts/run-backend-local.mjs",
    "backend:start:dev": "mvn -f apps/api/pom.xml spring-boot:run -Dspring-boot.run.profiles=dev",
    "backend:compile": "mvn -q -DskipTests compile -f apps/api/pom.xml",
    "backend:test": "mvn test -f apps/api/pom.xml",
    "functions:lint": "npm --prefix integrations/firebase-functions run lint",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:api": "docker compose logs -f api",
    "docker:web": "docker compose logs -f web",
    "docker:restart": "docker compose up -d --build --force-recreate",
    "docker:build:web": "docker compose build web --no-cache && docker compose up -d web",
    "docker:build:api": "docker compose build api --no-cache && docker compose up -d api",
    "docker:api:logs": "docker compose logs -f api",
    "docker:web:logs": "docker compose logs -f web",
    "docker:db:logs": "docker compose logs -f postgres"
  },
  "dependencies": {
    "@dataconnect/admin-generated": "file:src/dataconnect-admin-generated",
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@google-cloud/firestore": "^8.3.0",
    "dotenv": "^17.2.3",
    "firebase": "^12.12.0",
    "firebase-admin": "^10.3.0",
    "motion": "^12.38.0",
    "mysql2": "^3.15.3"
  }
}
